# ===== App =====
NODE_ENV=development
PORT=3000

# ===== Database (PostgreSQL) =====
# Local dev (Homebrew) often uses your OS user with no password:
#   DATABASE_URL=postgres://localhost:5432/inventory
# For Docker / hosted Postgres:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/inventory
DATABASE_URL=postgres://localhost:5432/inventory

# Set to true ONLY for tests / quick prototyping. Migrations are the source of truth.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ===== Auth =====
# Generate with: openssl rand -hex 32
# (not a secret in checks; replace it before deploying anywhere real)
JWT_SECRET=0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=1d

# ===== Frontend CORS =====
# Comma separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ===== Reporting microservice (Golang) =====
REPORTING_SERVICE_URL=http://localhost:8080
# Shared token the NestJS proxy sends to the reporting service. Leave empty in
# local dev (loopback trust); set it wherever the reporting port is reachable.
REPORTING_TOKEN=

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
